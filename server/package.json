{
  "name": "fluencyjet-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "build": "cd ../client && npm ci && npm run build && cd ../server && rm -rf dist && mkdir -p dist/public && cp -R ../client/dist/* dist/public/",
    "start": "NODE_ENV=production node index.js",
    "postinstall": "prisma generate",
    "seed": "node prisma/seed.js",
    "seed:quick-start": "node prisma/seed/quickStartSeed.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:phase2": "node --experimental-vm-modules node_modules/.bin/jest phase2 --runInBand",
    "test:phase3": "node --experimental-vm-modules node_modules/.bin/jest phase3 --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.19.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
