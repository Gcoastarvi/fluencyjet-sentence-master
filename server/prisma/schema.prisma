generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            Int                            @id @default(autoincrement())
  name                          String?                        @db.VarChar(100)
  email                         String                         @unique @db.VarChar(191)
  username                      String?                        @unique @db.VarChar(50)
  password                      String
  avatar_url                    String?
  has_access                    Boolean                        @default(false)
  tier_level                    String                         @default("free")
  created_at                    DateTime                       @default(now())
  isAdmin                       Boolean                        @default(false)
  lastActiveAt                  DateTime?
  xpTotal                       Int                            @default(0)
  league                        String                         @default("BRONZE")
  daily_streak                  Int                            @default(0)
  plan                          String                         @default("FREE")
  payments                      Payment[]
  sentenceMasterCheckoutIntents SentenceMasterCheckoutIntent[]
  spokenEnglishPurchases        SpokenEnglishPurchase[]
  user_badges                   UserBadge[]
  profile                       UserProfile?
  progress                      UserProgress?
  weekly                        UserWeeklyTotals?
  xp_events                     XpEvent[]
  league_history                LeagueHistory[]
  reset_tokens                  PasswordResetToken[]
  whatsappSuppressionClearances WhatsAppPhoneSuppression[]     @relation("WhatsAppSuppressionClearedBy")
  journeyMilestones             UserJourneyMilestone[]
  track                         String                         @default("BEGINNER")
  current_unit                  Int                            @default(1)
  level_check_result            String?
  level_check_score             Int?
  level_check_completed_at      DateTime?

  whatsapp_number            String?   @db.VarChar(30)
  whatsapp_number_normalized String?   @db.VarChar(20)
  whatsapp_consent           Boolean   @default(false)
  whatsapp_consent_at        DateTime?
  whatsapp_consent_source    String?   @db.VarChar(150)
  whatsapp_opted_out_at      DateTime?
  current_status             String?   @db.VarChar(80)
  main_goal                  String?   @db.VarChar(120)
  practice_commitment        String?   @db.VarChar(120)

  webinar_registered    Boolean   @default(false)
  webinar_registered_at DateTime?

  utm_source   String? @db.VarChar(150)
  utm_medium   String? @db.VarChar(150)
  utm_campaign String? @db.VarChar(200)
  utm_content  String? @db.VarChar(200)
  utm_term     String? @db.VarChar(200)
  source       String? @db.VarChar(150)
  campaign     String? @db.VarChar(200)
  adset        String? @db.VarChar(200)
  ad           String? @db.VarChar(200)

  activation_completed      Boolean   @default(false)
  last_demo_video_viewed_at DateTime?

  @@index([whatsapp_number_normalized])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LessonModeProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  Int
  mode      String
  completed Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId, mode])
  @@index([userId])
  @@index([lessonId])
}

model XpEvent {
  id         Int      @id @default(autoincrement())
  user_id    Int
  xp_delta   Int
  type       String   @db.VarChar(50)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, type])
}

model UserWeeklyTotals {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  week_key   DateTime
  month_key  DateTime?
  week_xp    Int       @default(0)
  month_xp   Int       @default(0)
  updated_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id])
}

model LeagueHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  leagueName  String // e.g., "BRONZE"
  rank        Int // e.g., 1
  xpEarned    Int // XP earned during that specific week
  seasonEnded DateTime @default(now())

  @@index([userId])
}

model UserProgress {
  id             Int      @id @default(autoincrement())
  user_id        Int      @unique
  xp             Int      @default(0)
  streak         Int      @default(0)
  updated_at     DateTime @default(now())
  streak_freezes Int      @default(0)
  league         String   @default("BRONZE")
  mission_streak Int      @default(0)
  user           User     @relation(fields: [user_id], references: [id])
}

model UserBadge {
  id         Int      @id @default(autoincrement())
  user_id    Int
  badge_name String
  earned_at  DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model Lesson {
  id          Int      @id @default(autoincrement())
  title       String
  created_at  DateTime @default(now())
  description String?
  difficulty  String   @default("beginner")
  isLocked    Boolean  @default(false)
  slug        String   @unique
  updated_at  DateTime @updatedAt
  quizzes     Quiz[]
}

model Quiz {
  id         Int      @id @default(autoincrement())
  lessonId   Int
  question   String
  type       String   @default("typing")
  prompt     String?
  data       Json?
  xpReward   Int      @default(50)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  userId    Int
  orderId   String   @unique
  paymentId String?  @unique
  signature String?
  amount    Int
  currency  String
  status    String
  plan      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model SpokenEnglishPurchase {
  id               String                        @id @default(cuid())
  paymentLinkId    String?
  paymentId        String                        @unique
  amount           Int
  currency         String                        @default("INR")
  status           String
  customerEmail    String?
  customerContact  String?
  userId           Int?
  productKey       String?                       @db.VarChar(80)
  sourceIntentId   String?                       @unique
  sourceIntent     SentenceMasterCheckoutIntent? @relation(fields: [sourceIntentId], references: [id], onDelete: SetNull)
  user             User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  webhookEventId   String                        @unique
  metaEventId      String
  metaDelivered    Boolean                       @default(false)
  metaError        String?
  metaResponseCode Int?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([userId, productKey, status])
  @@index([productKey, status])
}

model SentenceMasterCheckoutIntent {
  id                          String                 @id @default(cuid())
  userId                      Int
  productKey                  String                 @db.VarChar(80)
  learnerEmail                String                 @db.VarChar(191)
  destinationNumberNormalized String                 @db.VarChar(20)
  createdAt                   DateTime
  user                        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase                    SpokenEnglishPurchase?

  @@index([productKey, learnerEmail, destinationNumberNormalized, createdAt])
  @@index([userId, productKey, createdAt])
}

model DiagnosticQuestion {
  id         String      @id @default(uuid())
  isActive   Boolean     @default(true)
  type       QuizType
  promptEn   String?
  promptTa   String?
  payload    Json
  tag        WeaknessTag
  difficulty Int         @default(1)
  createdAt  DateTime    @default(now())
}

model DiagnosticAttempt {
  id           String    @id @default(uuid())
  anonId       String
  userId       Int?
  score        Int
  level        UserLevel
  weaknessTags String[]
  answers      Json
  createdAt    DateTime  @default(now())
}

model UserProfile {
  userId        Int           @id
  level         UserLevel
  weaknessTags  String[]
  webinarStatus WebinarStatus @default(NOT_SHOWN)
  planStatus    PlanStatus    @default(FREE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
}

model PracticeDay {
  id        String             @id @default(uuid())
  level     UserLevel
  dayNumber Int
  titleEn   String
  titleTa   String
  isActive  Boolean            @default(true)
  exercises PracticeExercise[]

  @@unique([level, dayNumber])
  @@index([level, isActive])
}

model PracticeExercise {
  id            String       @id @default(uuid())
  practiceDayId String
  type          ExerciseType
  promptTa      String
  hintTa        String?
  structureEn   String?
  expected      Json
  xp            Int          @default(50)
  orderIndex    Int
  practiceDay   PracticeDay  @relation(fields: [practiceDayId], references: [id])

  @@unique([practiceDayId, type, orderIndex])
  @@index([practiceDayId, type, orderIndex])
}

model UserDayProgress {
  id          String    @id @default(uuid())
  userId      Int
  level       UserLevel
  dayNumber   Int
  completed   Boolean   @default(false)
  xpEarned    Int       @default(0)
  completedAt DateTime?

  @@unique([userId, level, dayNumber])
  @@index([userId, level])
}

model AutomationEvent {
  id                          String                            @id @default(uuid())
  userId                      Int
  eventType                   AutomationType
  productKey                  String                            @default("sentence_master") @db.VarChar(80)
  status                      AutomationStatus                  @default(PENDING)
  payload                     Json?
  destinationNumberNormalized String?                           @db.VarChar(20)
  createdAt                   DateTime                          @default(now())
  sentAt                      DateTime?
  scheduledAt                 DateTime?
  cancelledAt                 DateTime?
  processedAt                 DateTime?
  providerMessageId           String?                           @unique @db.VarChar(255)
  sourceAutomationEventId     String?
  whatsappEvents              WhatsAppMessageEvent[]
  reconciliationJournal       AutomationReconciliationJournal[]
  // The createdAt fallback index is partial and is intentionally defined in SQL
  // migration 20260824000200 because Prisma schema indexes cannot express it.

  @@index([userId, eventType, status])
  @@index([userId, productKey, eventType, status])
  @@index([status, scheduledAt])
  @@index([eventType, status, scheduledAt])
  @@index([eventType, status, processedAt])
}

model UserJourneyMilestone {
  id            String   @id @default(uuid())
  userId        Int
  productKey    String   @db.VarChar(80)
  milestoneType String   @db.VarChar(80)
  occurredAt    DateTime
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productKey, milestoneType])
  @@index([productKey, milestoneType, occurredAt])
}

model WhatsAppMessageEvent {
  id                String                    @id @default(uuid())
  automationEventId String?
  automationEvent   AutomationEvent?          @relation(fields: [automationEventId], references: [id], onDelete: SetNull)
  suppressionSource WhatsAppPhoneSuppression? @relation("WhatsAppSuppressionSource")

  providerMessageId      String    @db.VarChar(255)
  eventType              String    @db.VarChar(50)
  recipientWaId          String?   @db.VarChar(30)
  senderWaId             String?   @db.VarChar(30)
  senderNumberNormalized String?   @db.VarChar(20)
  inboundClassification  String?   @db.VarChar(40)
  inboundCommand         String?   @db.VarChar(30)
  eventTimestamp         DateTime?

  errorCode    Int?
  errorTitle   String? @db.VarChar(255)
  errorDetails String?
  rawPayload   Json?

  dedupKey               String                            @unique @db.VarChar(64)
  createdAt              DateTime                          @default(now())
  reconciliationEvidence AutomationReconciliationJournal[] @relation("AutomationReconciliationEvidence")

  @@index([providerMessageId])
  @@index([automationEventId])
  @@index([eventType, eventTimestamp])
  @@index([eventType, createdAt])
}

model AutomationReconciliationJournal {
  id                String                 @id @default(uuid())
  automationEventId String
  automationEvent   AutomationEvent        @relation(fields: [automationEventId], references: [id], onDelete: Restrict)
  idempotencyKey    String                 @db.VarChar(128)
  requestHash       String                 @db.Char(64)
  action            ReconciliationAction
  decision          ReconciliationDecision
  priorStatus       AutomationStatus
  resultingStatus   AutomationStatus
  reasonCode        String                 @db.VarChar(64)
  evidenceEventId   String?
  evidenceEvent     WhatsAppMessageEvent?  @relation("AutomationReconciliationEvidence", fields: [evidenceEventId], references: [id], onDelete: SetNull)
  evidenceStatus    String?                @db.VarChar(20)
  authMethod        String                 @db.VarChar(40)
  createdAt         DateTime               @default(now())

  @@unique([automationEventId, idempotencyKey])
  @@index([automationEventId, createdAt])
  @@index([createdAt, id])
}

model WhatsAppPhoneSuppression {
  phoneNumberNormalized String                @id @db.VarChar(20)
  isOptedOut            Boolean               @default(true)
  optedOutAt            DateTime?
  optOutCommand         String?               @db.VarChar(30)
  sourceEventId         String?               @unique
  sourceEvent           WhatsAppMessageEvent? @relation("WhatsAppSuppressionSource", fields: [sourceEventId], references: [id], onDelete: SetNull)
  clearedAt             DateTime?
  clearanceSource       String?               @db.VarChar(150)
  clearanceReason       String?               @db.VarChar(255)
  clearedByUserId       Int?
  clearedByUser         User?                 @relation("WhatsAppSuppressionClearedBy", fields: [clearedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([isOptedOut, optedOutAt])
  @@index([clearedByUserId])
}

enum QuizType {
  FILL_BLANK
  ORDERING
  TA_TRANSLATION
  ERROR_SPOTTING
}

enum WeaknessTag {
  grammar
  word_order
  translation
  sentence_flow
  confidence
}

enum UserLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WebinarStatus {
  NOT_SHOWN
  SHOWN
  REGISTERED
  ATTENDED
}

enum PlanStatus {
  FREE
  PAID
}

enum ExerciseType {
  MAKE_SENTENCE
  FILL_BLANK
  DRAG_DROP
  TRANSLATE
}

enum AutomationType {
  DAY3_WEBINAR
  DAY5_UPGRADE
  LESSON1_SIGNUP_REMINDER
  LESSON1_WATCH_REMINDER
  LEARNING_PATH_DISCOVERY_REMINDER
  CHECKOUT_HELP_REMINDER
  ANY_QUESTIONS_REMINDER
}

enum AutomationStatus {
  PENDING
  SENDING
  SENT
  DONE
  CANCELLED
  DRY_RUN
}

enum ReconciliationAction {
  MARK_SENT
  QUARANTINE
}

enum ReconciliationDecision {
  APPLIED
  REJECTED
}
